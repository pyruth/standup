{
  "name": "standup",
  "version": "2.1.1",
  "description": "A private, offline-first stand-up reminder for Windows and Apple Silicon macOS.",
  "private": true,
  "type": "module",
  "author": "ioiostudio",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config vite.config.ts",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dist:win": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "dist:mac": "tauri build --bundles dmg --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lottie-web": "5.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
