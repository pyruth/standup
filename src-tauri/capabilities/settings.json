{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Minimal permissions for the local StandUp settings window.",
  "windows": ["settings"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show"
  ]
}
